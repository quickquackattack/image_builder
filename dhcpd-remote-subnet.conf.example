# DHCP Configuration for Remote Subnet Deployment
# This configuration handles servers in different subnets with MAC-based reservations
#
# Scenario: Boot server in one subnet, target servers in another subnet
# Requirements: DHCP relay agent or IP helper configured on the router

# Global settings
option domain-name "datacenter.local";
option domain-name-servers 8.8.8.8, 8.8.4.4;
default-lease-time 600;
max-lease-time 7200;
authoritative;
log-facility local7;

# PXE/UEFI boot options
option space pxelinux;
option pxelinux.magic code 208 = string;
option pxelinux.configfile code 209 = text;
option pxelinux.pathprefix code 210 = text;
option pxelinux.reboottime code 211 = unsigned integer 32;
option architecture-type code 93 = unsigned integer 16;

# ============================================================================
# BOOT SERVER SUBNET (where the HTTP/DHCP server lives)
# ============================================================================
subnet 192.168.1.0 netmask 255.255.255.0 {
    range 192.168.1.100 192.168.1.150;
    option routers 192.168.1.1;
    option broadcast-address 192.168.1.255;

    # Boot server configuration
    next-server 192.168.1.10;  # Replace with your boot server IP

    # UEFI HTTP Boot
    if option architecture-type = 00:0f {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }
    # UEFI PXE Boot
    elsif option architecture-type = 00:07 {
        filename "shimx64.efi";
    }
    else {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }
}

# ============================================================================
# REMOTE SUBNET (where your target servers are located)
# ============================================================================
# This subnet must have DHCP relay/IP helper configured on the router
# pointing to this DHCP server

subnet 10.20.30.0 netmask 255.255.255.0 {
    # Option 1: Dynamic pool for this subnet (if needed)
    range 10.20.30.100 10.20.30.150;

    option routers 10.20.30.1;
    option broadcast-address 10.20.30.255;

    # Boot server IP (must be routable from this subnet)
    next-server 192.168.1.10;  # Boot server IP

    # UEFI HTTP Boot configuration
    if option architecture-type = 00:0f {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }
    # UEFI PXE Boot
    elsif option architecture-type = 00:07 {
        filename "shimx64.efi";
    }
    else {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }
}

# ============================================================================
# MAC-BASED HOST RESERVATIONS
# ============================================================================
# Use these for specific servers where you know the MAC address

# Example: Production server with known MAC address
host prod-server-01 {
    hardware ethernet 00:1A:2B:3C:4D:5E;  # Replace with actual MAC
    fixed-address 10.20.30.50;             # Assign specific IP
    option host-name "prod-server-01.datacenter.local";

    # Force UEFI HTTP boot for this host
    if option architecture-type = 00:0f {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }
    elsif option architecture-type = 00:07 {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }
    else {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }

    # Custom kickstart for this specific host (optional)
    # option pxelinux.configfile "http://192.168.1.10/kickstart/prod-server-01.ks";
}

# Example: Another server in the same remote subnet
host prod-server-02 {
    hardware ethernet AA:BB:CC:DD:EE:FF;  # Replace with actual MAC
    fixed-address 10.20.30.51;
    option host-name "prod-server-02.datacenter.local";

    if option architecture-type = 00:0f {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }
}

# ============================================================================
# ADDITIONAL REMOTE SUBNETS
# ============================================================================
# Add more subnets as needed for multi-datacenter deployments

subnet 10.20.40.0 netmask 255.255.255.0 {
    range 10.20.40.100 10.20.40.150;
    option routers 10.20.40.1;
    option broadcast-address 10.20.40.255;
    next-server 192.168.1.10;

    if option architecture-type = 00:0f {
        filename "http://192.168.1.10/boot/efi/shimx64.efi";
    }
}

# ============================================================================
# SHARED NETWORK CONFIGURATION (Alternative approach)
# ============================================================================
# Use this if you need to serve multiple subnets through a single interface
# with DHCP relay

#shared-network datacenter {
#    subnet 192.168.1.0 netmask 255.255.255.0 {
#        # Boot server subnet config
#    }
#
#    subnet 10.20.30.0 netmask 255.255.255.0 {
#        # Remote subnet config
#    }
#}

# ============================================================================
# CONFIGURATION NOTES
# ============================================================================
#
# 1. Replace IP addresses:
#    - 192.168.1.10: Your boot server IP
#    - 10.20.30.0/24: Your remote subnet
#    - Gateway IPs for each subnet
#
# 2. Configure DHCP Relay on router:
#    For Cisco: ip helper-address 192.168.1.10
#    For Linux: dhcp-relay -i eth0 -s 192.168.1.10
#
# 3. Firewall requirements:
#    - Allow DHCP (UDP 67/68) from remote subnets
#    - Allow HTTP (TCP 80) from remote subnets to boot server
#    - Allow routing between subnets
#
# 4. Test with:
#    tcpdump -i any -n port 67 or port 68 or port 80
