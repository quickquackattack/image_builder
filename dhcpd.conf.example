# DHCP Server Configuration for UEFI HTTP Boot
# This configuration supports UEFI HTTP Boot for RHEL 9.4 installation
#
# Installation:
# 1. Copy this file to /etc/dhcp/dhcpd.conf
# 2. Update IP addresses and network settings for your environment
# 3. Enable and start the DHCP service:
#    systemctl enable dhcpd
#    systemctl start dhcpd

# Global DHCP settings
option domain-name "example.local";
option domain-name-servers 8.8.8.8, 8.8.4.4;
default-lease-time 600;
max-lease-time 7200;
authoritative;
log-facility local7;

# PXE/UEFI boot options
option space pxelinux;
option pxelinux.magic code 208 = string;
option pxelinux.configfile code 209 = text;
option pxelinux.pathprefix code 210 = text;
option pxelinux.reboottime code 211 = unsigned integer 32;
option architecture-type code 93 = unsigned integer 16;

# Subnet configuration
# Replace with your network settings
subnet 192.168.1.0 netmask 255.255.255.0 {
    range 192.168.1.100 192.168.1.200;
    option routers 192.168.1.1;
    option broadcast-address 192.168.1.255;

    # HTTP Boot Server IP
    # Replace YOUR_SERVER_IP with your actual HTTP boot server IP
    option next-server YOUR_SERVER_IP;

    # Boot file selection based on client architecture
    class "pxeclients" {
        match if substring (option vendor-class-identifier, 0, 9) = "PXEClient";
    }

    # UEFI HTTP Boot (x86_64) - Architecture type 0x0f (15)
    if option architecture-type = 00:0f {
        filename "http://YOUR_SERVER_IP/boot/efi/shimx64.efi";
        option vendor-class-identifier "HTTPClient";
    }
    # UEFI PXE Boot (x86_64) - Architecture type 0x07 (7)
    elsif option architecture-type = 00:07 {
        filename "shimx64.efi";
    }
    # UEFI PXE Boot (x86_64) - Architecture type 0x09 (9)
    elsif option architecture-type = 00:09 {
        filename "shimx64.efi";
    }
    # BIOS PXE Boot - Architecture type 0x00 (0)
    elsif option architecture-type = 00:00 {
        filename "pxelinux.0";
    }
    # Default to UEFI HTTP
    else {
        filename "http://YOUR_SERVER_IP/boot/efi/shimx64.efi";
    }
}

# Host-specific configuration example
# Uncomment and configure for specific hosts
